apiVersion: networking.istio.io/v1
kind: VirtualService
metadata:
  name: my-app-virtualservice
spec:
  hosts:
  - "myapp.example.com" # External host entry
#  - my-app-svc          # Internal mesh host entry
  gateways:
  - my-app-gateway      # Binds this routing rule to the edge gateway
#  - mesh                # Allows internal cluster-to-cluster traffic to respect the split
  http:
  - route:
    - destination:
        host: my-app-svc
        subset: v1
      weight: 90
    - destination:
        host: my-app-svc
        subset: v2
      weight: 10
