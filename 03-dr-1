
#### Example of destination rules traffic flow ####

client----myapp.example.com----istio-gateway(gw)----virtualService(vs)----destination rule(dr)----service(my-app-svc)-----subset: v1 90% /subset: v2 10%

root@controlplane:~$ 
root@controlplane:~$ cat  application.yaml 
apiVersion: apps/v1
kind: Deployment
metadata:
  name: my-app-v1
  labels:
    app: my-app
    version: v1
spec:
  replicas: 2
  selector:
    matchLabels:
      app: my-app
      version: v1
  template:
    metadata:
      labels:
        app: my-app
        version: v1
    spec:
      containers:
      - name: app
        image: docker.io/rohitrawat891997/httpd:latest  # Replace with your v1 image
        command: ['sh', '-c', 'echo "Hello World!" > /usr/local/apache2/htdocs/index.html && httpd-foreground']
        ports:
        - containerPort: 8080
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: my-app-v2
  labels:
    app: my-app
    version: v2
spec:
  replicas: 1
  selector:
    matchLabels:
      app: my-app
      version: v2
  template:
    metadata:
      labels:
        app: my-app
        version: v2
    spec:
      containers:
      - name: app
        image: docker.io/rohitrawat891997/httpd:latest  # Replace with your v2 image
        command: ['sh', '-c', 'echo "Hello Red Hat!" > /usr/local/apache2/htdocs/index.html && httpd-foreground']
        ports:
        - containerPort: 8080

---
apiVersion: v1
kind: Service
metadata:
  name: my-app-svc
  labels:
    app: my-app
spec:
  ports:
  - port: 8080
    name: http
    targetPort: 8080
  selector:
    app: my-app # Routes to all pods labeled app: my-app regardless of version
